{
  "name": "@appkings/backend",
  "version": "0.1.0",
  "private": true,
  "description": "AppKings 2026 Awards - Express API",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "node -e \"console.log('backend: plain JS, nothing to build')\"",
    "lint": "node --check src/index.js",
    "test": "node --test \"src/**/*.test.js\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:import": "node prisma/import-employees.js",
    "postinstall": "prisma generate",
    "db:reset": "prisma migrate reset --force --skip-generate && node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@appkings/shared": "*",
    "@prisma/client": "^6.15.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.15.0",
    "zod": "^3.25.76"
  }
}