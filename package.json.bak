{
  "name": "appkings-voting",
  "version": "0.1.0",
  "private": true,
  "description": "AppKings Solutions - 2026 Employee Awards Voting System",
  "workspaces": [
    "backend",
    "frontend",
    "packages/shared"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs api",
    "dev:web": "node scripts/dev.mjs web",
    "dev:all": "node scripts/dev.mjs all",
    "build": "npm run build --workspace @appkings/shared && npm run build --workspace @appkings/backend && npm run build --workspace @appkings/frontend",
    "start": "node scripts/dev.mjs",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "npm run lint --workspace @appkings/backend",
    "lint:web": "npm run build --workspace @appkings/frontend",
    "test": "npm run test:shared && npm run test:api",
    "test:shared": "npm run test --workspace @appkings/shared",
    "test:api": "npm run test --workspace @appkings/backend",
    "prisma:generate": "npm run prisma:generate --workspace @appkings/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace @appkings/backend",
    "db:deploy": "npm run prisma:deploy --workspace @appkings/backend",
    "db:seed": "npm run db:seed --workspace @appkings/backend",
    "db:import": "npm run db:import --workspace @appkings/backend --",
    "db:reset": "npm run db:reset --workspace @appkings/backend",
    "db:status": "npm exec --workspace @appkings/backend -- prisma migrate status",
    "docker:build": "docker compose -f infra/docker-compose.yml build",
    "docker:build:api": "docker build --target backend -t appkings-voting-api .",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:reset": "docker compose -f infra/docker-compose.yml down -v",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f app",
    "docker:ps": "docker compose -f infra/docker-compose.yml ps",
    "docker:shell": "docker compose -f infra/docker-compose.yml exec app sh",
    "docker:split": "docker compose -f infra/docker-compose.yml --profile split up -d --build",
    "docker:split:down": "docker compose -f infra/docker-compose.yml --profile split down",
    "docker:split:logs": "docker compose -f infra/docker-compose.yml --profile split logs -f api web",
    "docker:api": "docker compose -f infra/docker-compose.yml --profile split up -d --build api",
    "docker:web": "docker compose -f infra/docker-compose.yml --profile split up -d --build web",
    "dev:stack": "docker compose -f infra/docker-compose.dev.yml up --build",
    "dev:stack:bg": "docker compose -f infra/docker-compose.dev.yml up --build -d",
    "dev:stack:down": "docker compose -f infra/docker-compose.dev.yml down",
    "dev:stack:reset": "docker compose -f infra/docker-compose.dev.yml down -v",
    "dev:stack:logs": "docker compose -f infra/docker-compose.dev.yml logs -f app",
    "dev:stack:ps": "docker compose -f infra/docker-compose.dev.yml ps",
    "dev:split": "docker compose -f infra/docker-compose.dev.yml --profile split up --build",
    "dev:split:bg": "docker compose -f infra/docker-compose.dev.yml --profile split up --build -d",
    "dev:split:down": "docker compose -f infra/docker-compose.dev.yml --profile split down",
    "dev:split:logs": "docker compose -f infra/docker-compose.dev.yml --profile split logs -f api web",
    "stack:up": "npm run docker:up",
    "stack:down": "npm run docker:down",
    "stack:reset": "npm run docker:reset",
    "stack:logs": "npm run docker:logs",
    "stack:ps": "npm run docker:ps",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
