# AppKings 2026 Employee Awards — the stack, three ways to run it.
#
#   docker compose up -d                         → db + app (one container running api + web)
#                                                  on WEB_PORT (3000)
#   docker compose --profile split up -d         → db + api + web, separately (API_PORT 4000,
#                                                  WEB_PORT 3000)
#   docker compose --profile split up -d api     → db + api only
#   docker compose --profile split up -d web     → web only (needs an API somewhere)
#
# Inside the combined `app` container, supervisord runs Express on 127.0.0.1:4000 and
# Next.js on 3000; Next.js proxies /api/* to the API. Only port 3000 is published, so the
# session cookie is first-party and there is no CORS in the browser's path.
# See docs/deploy.md for the full runbook.
name: appkings-voting

x-app-env: &app-env
  NODE_ENV: production
  DATABASE_URL: postgresql://${POSTGRES_USER:-appkings}:${POSTGRES_PASSWORD:-appkings}@db:5432/${POSTGRES_DB:-appkings_voting}
  JWT_SECRET: ${JWT_SECRET:-change-me-to-a-long-random-string-at-least-32-chars}
  SESSION_HOURS: ${SESSION_HOURS:-12}
  FRONTEND_URL: ${FRONTEND_URL:-http://localhost:3000}
  COOKIE_SECURE: ${COOKIE_SECURE:-false}
  TRUST_PROXY: ${TRUST_PROXY:-1}
  SELF_NOMINATION_LIMIT: ${SELF_NOMINATION_LIMIT:-1}
  NOMINATION_MIN_JUSTIFICATION: ${NOMINATION_MIN_JUSTIFICATION:-20}
  TOP_PER_CATEGORY: ${TOP_PER_CATEGORY:-5}
  PHASE1_FINALISTS: ${PHASE1_FINALISTS:-15}
  PHASE2_FINALISTS_MIN: ${PHASE2_FINALISTS_MIN:-6}
  PHASE2_FINALISTS_MAX: ${PHASE2_FINALISTS_MAX:-10}
  MIN_CANDIDATES_PER_CATEGORY: ${MIN_CANDIDATES_PER_CATEGORY:-2}
  TEAM_FINALISTS: ${TEAM_FINALISTS:-3}
  COMMITTEE_PICKS_PER_CATEGORY: ${COMMITTEE_PICKS_PER_CATEGORY:-1}

services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-appkings}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-appkings}
      POSTGRES_DB: ${POSTGRES_DB:-appkings_voting}
    ports:
      - "${DB_PORT:-5432}:5432"
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-appkings} -d ${POSTGRES_DB:-appkings_voting}" ]
      interval: 5s
      timeout: 5s
      retries: 20

  # ------------------------------------------------------------------ default
  # One container, both apps (APP_ROLE=all). This is the "overall container", and the only
  # service without a profile, so a bare `docker compose up -d` brings up db + app.
  app:
    build:
      context: ..
      dockerfile: Dockerfile
      target: runtime
      args:
        NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-/api}
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      <<: *app-env
      APP_ROLE: all
      # The image listens on these two ports; only the web port is published.
      PORT: 3000
      API_PORT: 4000
      API_HOST: 127.0.0.1
      API_INTERNAL_URL: http://127.0.0.1:4000/api
      RUN_SEED: ${RUN_SEED:-true}
      SEED_DEMO: ${SEED_DEMO:-true}
    # The runtime image's WORKDIR is /app; prisma lives in /app/backend.
    working_dir: /app/backend
    ports:
      - "${WEB_PORT:-3000}:3000"

  # ------------------------------------------------------------------ split
  # API only — the same image built for the backend target (no Next.js).
  api:
    profiles: [ "split" ]
    build:
      context: ..
      dockerfile: Dockerfile
      target: backend
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      <<: *app-env
      APP_ROLE: api
      PORT: 4000
      API_HOST: 0.0.0.0
      RUN_SEED: ${RUN_SEED:-true}
      SEED_DEMO: ${SEED_DEMO:-true}
    ports:
      - "${API_PORT:-4000}:4000"

  # Web only — the same image, APP_ROLE=web, talking to the `api` service.
  web:
    profiles: [ "split" ]
    build:
      context: ..
      dockerfile: Dockerfile
      target: runtime
      args:
        NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-/api}
    restart: unless-stopped
    depends_on:
      - api
    environment:
      NODE_ENV: production
      APP_ROLE: web
      PORT: 3000
      API_INTERNAL_URL: http://api:4000/api
    ports:
      - "${WEB_PORT:-3000}:3000"

volumes:
  db_data:
