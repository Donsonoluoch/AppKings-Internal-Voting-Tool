# npm 11+/12 blocks package lifecycle scripts unless they are allowed here. Prisma needs
# its postinstall to fetch the engine and generate the client; without this, a fresh
# `npm install` leaves @prisma/client ungenerated and every DB call fails at runtime.
# (Run `npm run prisma:generate` as well — it is the explicit, deterministic step.)
allow-scripts[]=@prisma/client
allow-scripts[]=@prisma/engines
allow-scripts[]=prisma
