# AppKings Voting â€” copy to .env and set real credentials before use.
# Production Compose runs exactly two containers: web, and API + PostgreSQL.

# --- Database -------------------------------------------------------------
# Docker builds the API's local DATABASE_URL from POSTGRES_* values below.
# For Docker, replace the development password with a strong URL-safe value.
# Use a 64-character hexadecimal password to avoid connection-string escaping issues.
# DATABASE_URL is used only for native development outside Docker.
DATABASE_URL=postgresql://appkings:replace-me@host.docker.internal:5432/appkings_voting?schema=public
POSTGRES_USER=appkings
POSTGRES_PASSWORD=
POSTGRES_DB=appkings_voting

# --- API ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Change before any deployment. Must be at least 32 characters.
JWT_SECRET=
SESSION_HOURS=12
FRONTEND_URL=http://localhost:3300
COOKIE_SECURE=true
TRUST_PROXY=1
# Set these before the one-time production seed (never use a shared demo account).
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=

# --- Voting rules (see context Â§1, Â§5 and Â§14) ----------------------------
# Points only â€” there is no MAX_SCORE and nothing is converted to a percentage.
SELF_NOMINATION_LIMIT=1
NOMINATION_MIN_JUSTIFICATION=20
TOP_PER_CATEGORY=5
PHASE1_FINALISTS=15
PHASE2_FINALISTS_MIN=6
PHASE2_FINALISTS_MAX=10
MIN_CANDIDATES_PER_CATEGORY=2
TEAM_FINALISTS=3
COMMITTEE_PICKS_PER_CATEGORY=1

# --- Web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=/api

# --- Docker ---------------------------------------------------------------
# Seed on container start only when the roster workbook is available to the API container.
RUN_SEED=false

# --- Ports ---------------------------------------------------------------
WEB_PORT=3300
# Used by the optional local development Compose stack.
DB_PORT=127.0.0.1:5442
