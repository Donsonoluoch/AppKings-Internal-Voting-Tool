# AppKings Voting â€” copy to .env and set real credentials before use.
# Production Compose runs exactly two containers: web, and API + PostgreSQL.

# --- Database -------------------------------------------------------------
# Two deployment shapes; pick ONE.
#
# 1) External PostgreSQL (a managed/served database) — the go-live path:
#    set DATABASE_URL and leave POSTGRES_PASSWORD empty. The API skips its embedded
#    database entirely and runs `prisma migrate deploy` against this URL.
#    A single-instance API container is assumed (migrations run at start-up).
DATABASE_URL=
#
# 2) Embedded PostgreSQL inside the API container (the default when DATABASE_URL is empty):
#    leave DATABASE_URL empty and set a strong, URL-safe POSTGRES_PASSWORD (64 hex chars
#    avoids connection-string escaping issues).
# POSTGRES_USER=appkings
# POSTGRES_PASSWORD=
# POSTGRES_DB=appkings_voting

# --- API ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Change before any deployment. Must be at least 32 characters.
JWT_SECRET=
SESSION_HOURS=12
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=true
TRUST_PROXY=1
# Set before the one-time production seed (npm run db:golive). There is no default admin
# password: sign-in is by phone number only, so this number is the way in.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=Steve Martin

# --- Voting rules (see context Â§1, Â§5 and Â§14) ----------------------------
# Points only â€” there is no MAX_SCORE and nothing is converted to a percentage.
SELF_NOMINATION_LIMIT=1
TOP_PER_CATEGORY=5
PHASE1_FINALISTS=15
PHASE2_FINALISTS_MIN=6
PHASE2_FINALISTS_MAX=10
MIN_CANDIDATES_PER_CATEGORY=2
TEAM_FINALISTS=3
COMMITTEE_PICKS_PER_CATEGORY=1

# --- Web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=/api

# --- Docker ---------------------------------------------------------------
# One-time seed: `npm run db:golive` copies the workbook in and seeds, then verifies.
# RUN_SEED=true seeds on container start instead (only useful with the workbook mounted).
RUN_SEED=false

# --- Ports ---------------------------------------------------------------
WEB_PORT=3000
# Used by the optional local development Compose stack.
DB_PORT=127.0.0.1:5442
